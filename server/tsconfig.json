{
  "compilerOptions": {
    "module": "ESNext",
		"moduleResolution": "bundler",
    "target": "esnext",
		"rootDir": "./src",
		"outDir": "./dist",

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
		
    "strict": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
	"include": ["src/**/*"]
}
